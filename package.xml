<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ac_ros2_bridge</name>
  <version>0.1.0</version>
  <description>AC sim &lt;-&gt; ROS2 relay: subscribes Zenoh (from Windows ac_sim_bridge) and republishes standard ROS2 topics (ego_pose, detections_3d).</description>
  <maintainer email="todo@todo.local">ac_sim</maintainer>
  <license>TODO</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>ac_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- python-lz4 (depth/semantic LZ4 帧解压) 为 pip 包：pip install lz4（无
       rosdep 键，见 README 依赖节）。 -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
